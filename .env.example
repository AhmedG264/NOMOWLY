APP_NAME="منصة نمولي | Nomowly"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA
APP_TIMEZONE=Africa/Cairo

# HTTPS & Reverse Proxy Settings
APP_FORCE_HTTPS=false
TRUSTED_PROXIES=*

# Session & Cookie Security (Hostinger Production vs Local/Preview)
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SESSION_PARTITIONED_COOKIE=false

# Logging
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Database (MySQL 8+ Standard Hostinger / Local Configuration)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nomowly
DB_USERNAME=root
DB_PASSWORD=

# Session & Cache (File or Database drivers supported on shared hosting - No Redis)
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file

# Queue (Laravel Database Queue - Standard Hostinger Cron Friendly - No Redis/BullMQ)
QUEUE_CONNECTION=database

# Filesystem
FILESYSTEM_DISK=local

# Mail Configuration
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="no-reply@nomowly.com"
MAIL_FROM_NAME="${APP_NAME}"

# Multi-Currency Foundation (EGP, SAR, AED, KWD, QAR, BHD, OMR)
DEFAULT_CURRENCY=EGP
SUPPORTED_CURRENCIES=EGP,SAR,AED,KWD,QAR,BHD,OMR
HOLDING_PERIOD_DAYS=14
MIN_WITHDRAWAL_AMOUNT=150

# Initial Bootstrap Super Admin (Created via artisan nomowly:bootstrap-admin in Phase 2)
ADMIN_EMAIL=ahmedgamal264@outlook.com
ADMIN_INITIAL_PASSWORD=

# Payment Gateways (Moyasar for SAR/Mada/ApplePay, Tap for GCC/EGP/KNET)
# In production, set live keys. Leave empty to disable gateway until live credentials provided.
MOYASAR_API_KEY=
MOYASAR_PUBLISHABLE_KEY=
MOYASAR_WEBHOOK_SECRET=

TAP_SECRET_KEY=
TAP_PUBLIC_KEY=
TAP_WEBHOOK_SECRET=

# Fake Payment Gateway (Automatically disabled in production APP_ENV=production)
FAKE_PAYMENT_GATEWAY_ENABLED=false
FAKE_PAYMENT_GATEWAY_SECRET=sandbox_secret_nomowly_key

# Vite Frontend Build
VITE_APP_NAME="${APP_NAME}"
