# GEMINI_API_KEY: Optional for AI Studio runtime
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Database & Cache
DATABASE_URL="postgresql://nomowly_user:secure_password@localhost:5432/nomowly_prod?schema=public"
REDIS_URL="redis://localhost:6379"

# JWT Authentication
JWT_ACCESS_SECRET="replace-with-a-very-long-random-access-secret-key-32-bytes"
JWT_REFRESH_SECRET="replace-with-a-very-long-random-refresh-secret-key-32-bytes"

# Cryptography (AES-256-GCM authenticated encryption + HMAC-SHA256 Fingerprints)
ENCRYPTION_MASTER_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
ENCRYPTION_KEY_VERSION="v1"
HMAC_FINGERPRINT_SECRET="replace-with-a-secure-hmac-fingerprint-salt-key-32-bytes"

# Networking
PORT=3000
APP_URL="http://localhost:3000"
API_URL="http://localhost:3000/api/v1"

# Nomowly Business Defaults (SAR)
DEFAULT_CURRENCY="SAR"
DEFAULT_COOKIE_DURATION_DAYS=30
DEFAULT_LOCK_PERIOD_DAYS=30
DEFAULT_PLATFORM_FEE_RATE=0.02
MIN_WITHDRAWAL_AMOUNT=150
